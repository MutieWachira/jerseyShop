generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReceiptStatus {
  DRAFT
  FINALIZED
  EMAILED
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

enum KitVersion {
  FAN
  PLAYER
}

enum PaymentMethod {
  MPESA
  FLUTTERWAVE
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum AuditLevel {
  INFO
  WARN
  ERROR
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  cartItems   CartItem[]
  orders      Order[]
  withdrawals Withdrawal[]
  reviews     Review[]
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String           @unique
  description    String
  price          Int // Stored in minor currency units (cents/Ksh whole integer format)
  image          String
  team           String
  seoTitle       String?
  seoDescription String?
  active         Boolean          @default(true)
  featured       Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([team])
  @@index([categoryId])
  @@index([createdAt])
  @@index([slug])
  @@index([active])
  @@index([featured])
}

//////////////////////////////////////////////////////
// PRODUCT VARIANT
//////////////////////////////////////////////////////

model ProductVariant {
  id            String      @id @default(cuid())
  productId     Int
  size          Size
  version       KitVersion
  stock         Int
  reservedStock Int         @default(0)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // FIXED: Standardized spacer syntax to prevent compilation formatting bugs
  @@index([productId])
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

//////////////////////////////////////////////////////
// DISCOUNT
//////////////////////////////////////////////////////

model Discount {
  id              String    @id @default(cuid())
  code            String    @unique
  percentage      Int
  minimumOrder    Int?
  maximumDiscount Int?
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  orders          Order[]

  @@index([code])
  @@index([active])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// ORDER
//////////////////////////////////////////////////////

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String
  notes  String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  shippingName    String
  shippingEmail   String
  shippingPhone   String
  shippingAddress String
  shippingCity    String

  paymentMethod PaymentMethod
  status        OrderStatus   @default(PENDING_PAYMENT)

  subtotal       Int
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  tax            Int @default(0)
  total          Int

  discountId   String?
  discountCode String?
  discountPct  Int?
  discount     Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  receipt  Receipt?
  payments Payment[]
  timeline OrderTimeline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([discountId])
  @@index([paymentMethod])
  @@index([orderNumber])
}

//////////////////////////////////////////////////////
// ORDER ITEM
//////////////////////////////////////////////////////

model OrderItem {
  id      Int    @id @default(autoincrement())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName String
  image       String?

  // IMPROVED: Strict explicit mapping to schema global type declarations
  size    Size
  version KitVersion

  quantity             Int
  unitPrice            Int
  customizationCost    Int     @default(0)
  customizationDetails String?
  totalPrice           Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

//////////////////////////////////////////////////////
// RECEIPT
//////////////////////////////////////////////////////

model Receipt {
  id            String @id @default(cuid())
  receiptNumber String @unique

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status ReceiptStatus @default(DRAFT)

  subtotal    Int
  discount    Int
  shippingFee Int
  tax         Int

  total       Int

  pdfUrl    String?
  emailed   Boolean   @default(false)
  emailedAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptNumber])
  @@index([orderId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          PaymentMethod
  paymentReference  String        @unique
  checkoutRequestId String?
  transactionId     String?

  amount   Int
  currency String  @default("KES")
  phone    String?

  status PaymentStatus @default(PENDING)

  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([checkoutRequestId])
  @@index([paymentReference])
  @@index([transactionId])
}

model Withdrawal {
  id              String           @id @default(cuid())
  adminId         String
  admin           User             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  amount          Int
  currency        String           @default("KES")
  phone           String
  status          WithdrawalStatus @default(PENDING)
  reference       String           @unique
  transactionId   String?
  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// ORDER TIMELINE
//////////////////////////////////////////////////////

model OrderTimeline {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status   OrderStatus
  message  String
  actor    String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orderId])
}

//////////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////////

model Review {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// APPLICATION SETTINGS
//////////////////////////////////////////////////////

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String    @id @default(cuid())
  actorId      String?
  actorType    String?   // e.g. "USER", "SYSTEM", "ADMIN"
  action       String
  resourceType String?   // e.g. "Order", "Payment", "Withdrawal"
  resourceId   String?
  level        AuditLevel @default(INFO)
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
}

//////////////////////////////////////////////////////
// NEXTAUTH ACCOUNT
//////////////////////////////////////////////////////

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// NEXTAUTH SESSION
//////////////////////////////////////////////////////

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

//////////////////////////////////////////////////////
// NEXTAUTH VERIFICATION TOKEN
//////////////////////////////////////////////////////

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
